# ==============================================================================
# CAMPUSRESOLVE AI — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env for local development or configure in Vercel Project Settings.
# Never commit real secret credentials (.env, .env.local, .env.production) to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PUBLIC FRONTEND & SHARED SUPABASE VARIABLES (Exposed to Vite Client + Server)
# ------------------------------------------------------------------------------
# Supabase Project URL (e.g., https://llotsqzeppiltosllxvx.supabase.co)
VITE_SUPABASE_URL="https://your-supabase-project-ref.supabase.co"
# Supabase Publishable / Anon Key (safe for browser under forced PostgreSQL RLS)
VITE_SUPABASE_PUBLISHABLE_KEY="your_supabase_anon_or_publishable_key"

# ------------------------------------------------------------------------------
# 2. PUBLIC FRONTEND FIREBASE GOOGLE AUTHENTICATION VARIABLES (Vite Client)
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY="your_firebase_web_api_key"
VITE_FIREBASE_AUTH_DOMAIN="campusresolveai.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="campusresolveai"
VITE_FIREBASE_STORAGE_BUCKET="campusresolveai.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="671221539968"
VITE_FIREBASE_APP_ID="your_firebase_web_app_id"

# ------------------------------------------------------------------------------
# 3. SERVER-ONLY SUPABASE PRIVILEGED AUDIT & SEED KEY (Never prefix with VITE_)
# ------------------------------------------------------------------------------
# Optional in runtime (used for privileged server-side audit logging and bulk seed script)
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_secret_key"

# ------------------------------------------------------------------------------
# 4. SERVER-ONLY GEMINI AI POLICY ASSISTANT CONFIGURATION (Never prefix with VITE_)
# ------------------------------------------------------------------------------
# Google Gemini API key used by /api/ai/policy-assistant (@google/genai)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ------------------------------------------------------------------------------
# 5. SERVER-ONLY FIREBASE ADMIN SDK (Spark-Plan Custom Claim Bridge)
# ------------------------------------------------------------------------------
# Used by /api/auth/firebase-claim to assign custom claim role="authenticated"
FIREBASE_ADMIN_PROJECT_ID="campusresolveai"
FIREBASE_ADMIN_CLIENT_EMAIL="firebase-adminsdk-xxxxx@campusresolveai.iam.gserviceaccount.com"
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# 6. SERVER-ONLY GOOGLE APPS SCRIPT + GMAIL WELCOME EMAIL AUTOMATION
# ------------------------------------------------------------------------------
# Used by /api/auth/welcome-email to invoke WelcomeEmailWebApp.gs (campusresolveai@gmail.com)
APPS_SCRIPT_WEB_APP_URL="https://script.google.com/macros/s/your-deployment-id/exec"
APPS_SCRIPT_SHARED_SECRET="your-high-entropy-shared-secret-minimum-32-chars"
APPLICATION_BASE_URL="https://your-application-domain.vercel.app"
APP_URL="https://your-application-domain.vercel.app"
