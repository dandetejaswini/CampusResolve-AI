# ==============================================================================
# CAMPUSRESOLVE AI — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env for local development or configure in Vercel.
# Never commit actual credentials or secret values to GitHub.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE CONFIGURATION — FRONTEND
# ------------------------------------------------------------------------------

VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your_supabase_publishable_or_anon_key"

# ------------------------------------------------------------------------------
# 2. FIREBASE GOOGLE AUTHENTICATION — FRONTEND
# ------------------------------------------------------------------------------

VITE_FIREBASE_API_KEY="your_firebase_web_api_key"
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your_firebase_project_id"
VITE_FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="your_messaging_sender_id"
VITE_FIREBASE_APP_ID="your_firebase_web_app_id"

# ------------------------------------------------------------------------------
# 3. SUPABASE PRIVILEGED ACCESS — SERVER ONLY
# ------------------------------------------------------------------------------

SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key"

# ------------------------------------------------------------------------------
# 4. GOOGLE GEMINI AI — SERVER ONLY
# ------------------------------------------------------------------------------

GEMINI_API_KEY="your_gemini_api_key"

# ------------------------------------------------------------------------------
# 5. FIREBASE ADMIN SDK — SERVER ONLY
# ------------------------------------------------------------------------------

FIREBASE_ADMIN_PROJECT_ID="your_firebase_project_id"
FIREBASE_ADMIN_CLIENT_EMAIL="your_firebase_admin_service_account_email"
FIREBASE_ADMIN_PRIVATE_KEY="your_firebase_admin_private_key"

# ------------------------------------------------------------------------------
# 6. GOOGLE APPS SCRIPT AND EMAIL AUTOMATION — SERVER ONLY
# ------------------------------------------------------------------------------

APPS_SCRIPT_WEB_APP_URL="your_google_apps_script_web_app_url"
APPS_SCRIPT_SHARED_SECRET="your_secure_random_shared_secret"
APPLICATION_BASE_URL="https://your-application.vercel.app"
APP_URL="https://your-application.vercel.app"
